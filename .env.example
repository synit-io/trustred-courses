# ============================================================================
# Aid Org Courses - environment template
# ----------------------------------------------------------------------------
# Notes:
# - All values are strings in .env (numbers/booleans are parsed at runtime).
# - "Default" means runtime fallback when the variable is not set.
# - Required/optional can depend on feature usage (see notes per variable).
# ============================================================================

# ============================================================================
# App / tenant identity
# ============================================================================

# APP_NAME
# Purpose: Displayed in UI/email branding.
# Required: Optional
# Default: Aid Org Courses
# Allowed/example: any non-empty string, e.g. "Feuerwehr Musterstadt"
APP_NAME="Aid Org Courses"

# APP_BASE_URL
# Purpose: Absolute base URL for links/callbacks (auth, DOI, PayPal return).
# Required: Optional (but should always be set correctly)
# Default: http://localhost:8000
# Allowed/example:
# - local: "http://localhost:8000"
# - production: "https://courses.example.org"
APP_BASE_URL="http://localhost:8000"

# INITIAL_ADMIN_EMAIL
# Purpose: Initial super-admin bootstrap identity.
# Required: Optional
# Default: admin@example.org
# Allowed/example: valid email address, e.g. "admin@example.org"
INITIAL_ADMIN_EMAIL="admin@example.org"

# KV_PATH
# Purpose: Local/self-hosted Deno KV file path.
# Required: Optional (ignored on Deno Deploy managed KV)
# Default: .data/aid-org-courses.kv
# Allowed/example: relative or absolute filesystem path
KV_PATH=".data/aid-org-courses.kv"

# ============================================================================
# Authentication / session / login security
# ============================================================================

# AUTH_COOKIE_NAME
# Purpose: Session cookie name.
# Required: Optional
# Default: session
# Allowed/example: token-safe cookie name, e.g. "session"
AUTH_COOKIE_NAME="session"

# AUTH_MAGIC_LINK_BINDING_COOKIE_NAME
# Purpose: Cookie used for magic-link one-time binding protection.
# Required: Optional
# Default: ml_bind
# Allowed/example: token-safe cookie name, e.g. "ml_bind"
AUTH_MAGIC_LINK_BINDING_COOKIE_NAME="ml_bind"

# AUTH_COOKIE_SECURE
# Purpose: Set secure flag for auth cookies.
# Required: Optional
# Default: false
# Allowed values: "true", "false"
# Example: "true" in HTTPS production environments
AUTH_COOKIE_SECURE="false"

# AUTH_DEV_EXPOSE_MAGIC_LINK
# Purpose: Enables dev debug link exposure (localhost-only guard still applies).
# Required: Optional
# Default: true
# Allowed values: "true", "false"
AUTH_DEV_EXPOSE_MAGIC_LINK="true"

# MAGIC_LINK_TTL_MINUTES
# Purpose: Magic link expiration window.
# Required: Optional
# Default: 15
# Allowed/example: positive integer string, e.g. "15"
MAGIC_LINK_TTL_MINUTES="15"

# SESSION_IDLE_TTL_DAYS
# Purpose: Session idle timeout in days.
# Required: Optional
# Default: 7
# Allowed/example: positive integer string, e.g. "7"
SESSION_IDLE_TTL_DAYS="7"

# SESSION_ABSOLUTE_TTL_DAYS
# Purpose: Session absolute max lifetime in days.
# Required: Optional
# Default: 30
# Allowed/example: positive integer string, e.g. "30"
SESSION_ABSOLUTE_TTL_DAYS="30"

# REGISTRATION_DOUBLE_OPT_IN_TTL_HOURS
# Purpose: Double-opt-in token validity in hours.
# Required: Optional
# Default: 48
# Allowed/example: positive integer string, e.g. "48"
REGISTRATION_DOUBLE_OPT_IN_TTL_HOURS="48"

# AUTH_RATE_LIMIT_MAX_ATTEMPTS
# Purpose: Max failed login attempts before temporary block.
# Required: Optional
# Default: 5
# Allowed/example: integer string, e.g. "5"
AUTH_RATE_LIMIT_MAX_ATTEMPTS="5"

# AUTH_RATE_LIMIT_WINDOW_MINUTES
# Purpose: Rolling window for failed login attempt counting.
# Required: Optional
# Default: 15
# Allowed/example: integer string, e.g. "15"
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"

# AUTH_RATE_LIMIT_BLOCK_MINUTES
# Purpose: Block duration after too many failed login attempts.
# Required: Optional
# Default: 15
# Allowed/example: integer string, e.g. "15"
AUTH_RATE_LIMIT_BLOCK_MINUTES="15"

# ============================================================================
# Logging / observability
# ============================================================================

# LOG_LEVEL
# Purpose: Log verbosity threshold.
# Required: Optional
# Default: info
# Allowed values: "debug", "info", "warn", "error"
LOG_LEVEL="info"

# LOG_FORMAT
# Purpose: Log output format.
# Required: Optional
# Default: json
# Allowed values: "json", "pretty"
LOG_FORMAT="json"

# ============================================================================
# Embedding / CSP frame-ancestors
# ============================================================================

# EMBED_ALLOWED_ORIGINS
# Purpose: Allowed frame ancestors for embedding.
# Required: Optional
# Default: *
# Allowed/example:
# - "*" (allow all)
# - "'self'" (self only)
# - comma-separated origins, e.g. "https://portal.example.org,https://app.example.org"
EMBED_ALLOWED_ORIGINS="*"

# ============================================================================
# SMTP / outgoing mail
# ============================================================================

# SMTP_HOST
# Purpose: SMTP hostname for transactional emails.
# Required:
# - required in production
# - optional for local dev debug login mode
# Default: empty
# Allowed/example: hostname, e.g. "smtp.example.org"
SMTP_HOST="smtp.example.org"

# SMTP_PORT
# Purpose: SMTP port.
# Required: Optional
# Default: 587
# Allowed/example: integer string, e.g. "587" (STARTTLS) or "465" (SMTPS)
SMTP_PORT="587"

# SMTP_USER
# Purpose: SMTP username.
# Required:
# - required in production
# - optional for local dev debug login mode
# Default: empty
# Allowed/example: account identifier
SMTP_USER="smtp-user"

# SMTP_PASS
# Purpose: SMTP password or app password.
# Required:
# - required in production
# - optional for local dev debug login mode
# Default: empty
# Allowed/example: secret string
SMTP_PASS="smtp-password"

# SMTP_SECURE
# Purpose: SMTP TLS mode (true usually for port 465, false for 587 STARTTLS).
# Required: Optional
# Default: false
# Allowed values: "true", "false"
SMTP_SECURE="false"

# MAIL_FROM_ADDRESS
# Purpose: From address used for outgoing emails.
# Required:
# - required in production
# - optional for local dev debug login mode
# Default: empty
# Allowed/example: valid sender email
MAIL_FROM_ADDRESS="noreply@example.org"

# MAIL_FROM_NAME
# Purpose: Display name for outgoing emails.
# Required: Optional
# Default: Aid Org Courses
# Allowed/example: any display name, e.g. "Aid Org Courses"
MAIL_FROM_NAME="Aid Org Courses"

# MAIL_ADMIN_NOTIFICATION_TO
# Purpose: Optional admin mailbox for new-registration notifications.
# Required: Optional
# Default: empty (disabled)
# Allowed/example: valid email or empty string
MAIL_ADMIN_NOTIFICATION_TO="committee@example.org"

# ============================================================================
# Legal / imprint data
# ============================================================================

# LEGAL_ORGANIZATION_NAME
# Purpose: Public legal organization name.
# Required: Optional
# Default: Aid Org Courses
# Allowed/example: full legal name
LEGAL_ORGANIZATION_NAME="Aid Org Courses e.V."

# LEGAL_REPRESENTATIVE
# Purpose: Public legal representative.
# Required: Optional
# Default: Max Mustermann
# Allowed/example: person name
LEGAL_REPRESENTATIVE="Max Mustermann"

# LEGAL_STREET
# Purpose: Public legal street address.
# Required: Optional
# Default: Musterstrasse 1
# Allowed/example: street + number
LEGAL_STREET="Musterstrasse 1"

# LEGAL_POSTAL_CODE
# Purpose: Public legal postal code.
# Required: Optional
# Default: 12345
# Allowed/example: postal code string
LEGAL_POSTAL_CODE="12345"

# LEGAL_CITY
# Purpose: Public legal city.
# Required: Optional
# Default: Musterstadt
# Allowed/example: city name
LEGAL_CITY="Musterstadt"

# LEGAL_EMAIL
# Purpose: Public legal contact email.
# Required: Optional
# Default: kontakt@example.org
# Allowed/example: valid email
LEGAL_EMAIL="kontakt@example.org"

# LEGAL_PHONE
# Purpose: Public legal contact phone.
# Required: Optional
# Default: +49 000 000000
# Allowed/example: phone number or contact text
LEGAL_PHONE="+49 000 000000"

# ============================================================================
# PayPal (required only for paid courses)
# ============================================================================

# PAYPAL_ENVIRONMENT
# Purpose: Select PayPal API environment.
# Required:
# - required when paid courses are enabled
# - optional when only free courses are used
# Default: sandbox
# Allowed values: "sandbox", "live"
PAYPAL_ENVIRONMENT="sandbox"

# PAYPAL_CLIENT_ID
# Purpose: PayPal REST app client id.
# Required:
# - required when paid courses are enabled
# - optional when only free courses are used
# Default: empty
# Allowed/example: PayPal client id string
PAYPAL_CLIENT_ID=""

# PAYPAL_CLIENT_SECRET
# Purpose: PayPal REST app client secret.
# Required:
# - required when paid courses are enabled
# - optional when only free courses are used
# Default: empty
# Allowed/example: PayPal client secret string
PAYPAL_CLIENT_SECRET=""
